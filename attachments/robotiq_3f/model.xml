<mujoco model="robotiq_3f_gripper">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option integrator="implicitfast" cone="elliptic" impratio="10"/>

  <default>
    <default class="robotiq_3f">
      <joint type="hinge" damping="0.15" armature="0.002" frictionloss="0.02"/>
      <position kp="30" kv="2" forcerange="-5 5"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" density="0"/>
      </default>
      <default class="collision">
        <!-- contype=0 prevents gripper self-collision while retaining contact with ordinary objects. -->
        <geom type="box" contype="0" conaffinity="1" group="3" friction="1.2 0.08 0.01" condim="4"/>
      </default>
      <default class="finger_tip_collision">
        <geom type="box" contype="0" conaffinity="1" group="3" condim="4"
          friction="2 0.1 0.01" solimp="0.9 0.98 0.001" solref="0.004 1" priority="1"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="black_metal" rgba="0.015 0.015 0.018 1" metallic="0" roughness="0.4"/>
    <material name="metal" rgba="0.82745 0.84314 0.81176 1" metallic="0.25" roughness="0.4"/>
    <mesh name="base_black" file="base_black.obj"/>
    <mesh name="base_metal" file="base_metal.obj"/>
    <mesh name="finger_palm" file="finger_palm.obj"/>
    <mesh name="finger_proximal" file="finger_proximal.obj"/>
    <mesh name="finger_middle" file="finger_middle.obj"/>
    <mesh name="finger_distal" file="finger_distal.obj"/>
  </asset>

  <worldbody>
    <body name="robotiq_3f_gripper" childclass="robotiq_3f">
      <site name="attachment_site" pos="0 0 0" quat="1 0 0 0" size="0.004" group="4"/>
      <site name="gripper_target" pos="0 0 0.18" quat="1 0 0 0" size="0.006" group="4"/>

      <!-- Webots models the gripper along +Y. This fixed frame points it along Critter's +Z tool axis
           and places the rear face of the housing at the attachment site. -->
      <body name="base" pos="0 0 0.052" quat="0.7071067812 0.7071067812 0 0">
        <geom class="visual" mesh="base_black" material="black_metal"/>
        <geom class="visual" mesh="base_metal" material="metal"/>
        <geom class="collision" type="cylinder" pos="0 -0.029 0" size="0.023 0.025" mass="0.2"/>
        <geom class="collision" pos="0 0.005 0" size="0.063 0.0465 0.065" mass="0.8"/>

        <body name="finger_1_link_0" pos="-0.0455 0.0214 0.036"
          quat="-0.0000026732 0.7068252251 0.7073882252 0.000003">
          <joint name="palm_finger_1_joint" axis="0 1 0" range="-0.192 0.1784"/>
          <geom class="visual" mesh="finger_palm" pos="0.02 0 0" material="black_metal"/>
          <geom class="collision" pos="0.007 0.006 0" size="0.02 0.02 0.016" mass="0.05"/>
          <body name="finger_1_link_1" pos="0.02 0 0">
            <joint name="finger_1_joint_1" axis="0 0 1" ref="0.0495" range="0.0495 1.2218"/>
            <geom class="visual" mesh="finger_proximal" pos="0.05 -0.028 0"
              quat="0.9663899781 0 0 -0.2570805519" material="black_metal"/>
            <geom class="collision" pos="0.0123158 -0.02039 0" size="0.0455 0.019 0.016"
              quat="0.9728196178 0 0 -0.231564227" mass="0.15"/>
            <body name="finger_1_link_2" pos="0.05 -0.028 0"
              quat="0.9663899781 0 0 -0.2570805519">
              <joint name="finger_1_joint_2" axis="0 0 1" range="0 1.5708"/>
              <geom class="visual" mesh="finger_middle" pos="0.039 0 0.0075" material="black_metal"/>
              <geom class="collision" pos="0.02694 -0.00895 0" size="0.02 0.016 0.016"
                quat="0.9999211755 0 0 -0.0125555916" mass="0.15"/>
              <body name="finger_1_link_3" pos="0.039 0 0">
                <joint name="finger_1_joint_3" axis="0 0 1" ref="-0.0523" range="-1.2217 -0.0523"/>
                <geom class="visual" mesh="finger_distal" quat="0.9663899781 0 0 0.2570805519"
                  material="metal"/>
                <geom name="finger_1_pad" class="finger_tip_collision" pos="0.0180036 0.00913251 0"
                  size="0.0175 0.009 0.016" quat="0.9663567075 0 0 0.2572055867" mass="0.05"/>
              </body>
            </body>
          </body>
        </body>

        <body name="finger_2_link_0" pos="-0.0455 0.0214 -0.036"
          quat="-0.0000026732 0.7068252251 0.7073882252 0.000003">
          <joint name="palm_finger_2_joint" axis="0 1 0" range="-0.192 0.1784"/>
          <geom class="visual" mesh="finger_palm" pos="0.02 0 0" material="black_metal"/>
          <geom class="collision" pos="0.007 0.006 0" size="0.02 0.02 0.016" mass="0.05"/>
          <body name="finger_2_link_1" pos="0.02 0 0">
            <joint name="finger_2_joint_1" axis="0 0 1" ref="0.0495" range="0.0495 1.2218"/>
            <geom class="visual" mesh="finger_proximal" pos="0.05 -0.028 0"
              quat="0.9663899781 0 0 -0.2570805519" material="black_metal"/>
            <geom class="collision" pos="0.012315 -0.02039 0" size="0.0455 0.019 0.016"
              quat="0.9728196178 0 0 -0.231564227" mass="0.15"/>
            <body name="finger_2_link_2" pos="0.05 -0.028 0"
              quat="0.9663899781 0 0 -0.2570805519">
              <joint name="finger_2_joint_2" axis="0 0 1" range="0 1.5708"/>
              <geom class="visual" mesh="finger_middle" pos="0.039 0 0.0075" material="black_metal"/>
              <geom class="collision" pos="0.02694 -0.00895 0" size="0.02 0.016 0.016"
                quat="0.9999211755 0 0 -0.0125555916" mass="0.15"/>
              <body name="finger_2_link_3" pos="0.039 0 0">
                <joint name="finger_2_joint_3" axis="0 0 1" ref="-0.0523" range="-1.2217 -0.0523"/>
                <geom class="visual" mesh="finger_distal" quat="0.9663899781 0 0 0.2570805519"
                  material="metal"/>
                <geom name="finger_2_pad" class="finger_tip_collision" pos="0.018 0.00913 0"
                  size="0.0175 0.009 0.016" quat="0.9663567075 0 0 0.2572055867" mass="0.05"/>
              </body>
            </body>
          </body>
        </body>

        <body name="finger_middle_mount" pos="0.0455 0.0214 0"
          quat="0.7073882692 0 0 0.7068251811">
          <geom class="visual" mesh="finger_palm" pos="0.02 0 0" material="black_metal"/>
          <body name="finger_middle_link_1" pos="0.02 0 0">
            <joint name="finger_middle_joint_1" axis="0 0 1" ref="0.0495" range="0.0495 1.2218"/>
            <geom class="visual" mesh="finger_proximal" pos="0.05 -0.028 0"
              quat="0.9663899781 0 0 -0.2570805519" material="black_metal"/>
            <geom class="collision" pos="0.01231 -0.02039 0" size="0.0455 0.019 0.016"
              quat="0.9728196178 0 0 -0.231564227" mass="0.15"/>
            <body name="finger_middle_link_2" pos="0.05 -0.028 0"
              quat="0.9663899781 0 0 -0.2570805519">
              <joint name="finger_middle_joint_2" axis="0 0 1" range="0 1.5708"/>
              <geom class="visual" mesh="finger_middle" pos="0.039 0 0.0075" material="black_metal"/>
              <geom class="collision" pos="0.02694 -0.008952 0" size="0.02 0.016 0.016"
                quat="0.9999211755 0 0 -0.0125555916" mass="0.15"/>
              <body name="finger_middle_link_3" pos="0.039 0 0">
                <joint name="finger_middle_joint_3" axis="0 0 1" ref="-0.0523" range="-1.2217 -0.0523"/>
                <geom class="visual" mesh="finger_distal" quat="0.9663899781 0 0 0.2570805519"
                  material="metal"/>
                <geom name="finger_middle_pad" class="finger_tip_collision" pos="0.018 0.00913 0"
                  size="0.0175 0.009 0.016" quat="0.9663567075 0 0 0.2572055867" mass="0.05"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position class="robotiq_3f" name="palm_finger_1" joint="palm_finger_1_joint" ctrlrange="-0.192 0.1784"/>
    <position class="robotiq_3f" name="finger_1_proximal" joint="finger_1_joint_1" ctrlrange="0.0495 1.2218"/>
    <position class="robotiq_3f" name="finger_1_middle" joint="finger_1_joint_2" ctrlrange="0 1.5708"/>
    <position class="robotiq_3f" name="finger_1_distal" joint="finger_1_joint_3" ctrlrange="-1.2217 -0.0523"/>
    <position class="robotiq_3f" name="palm_finger_2" joint="palm_finger_2_joint" ctrlrange="-0.192 0.1784"/>
    <position class="robotiq_3f" name="finger_2_proximal" joint="finger_2_joint_1" ctrlrange="0.0495 1.2218"/>
    <position class="robotiq_3f" name="finger_2_middle" joint="finger_2_joint_2" ctrlrange="0 1.5708"/>
    <position class="robotiq_3f" name="finger_2_distal" joint="finger_2_joint_3" ctrlrange="-1.2217 -0.0523"/>
    <position class="robotiq_3f" name="finger_middle_proximal" joint="finger_middle_joint_1" ctrlrange="0.0495 1.2218"/>
    <position class="robotiq_3f" name="finger_middle_middle" joint="finger_middle_joint_2" ctrlrange="0 1.5708"/>
    <position class="robotiq_3f" name="finger_middle_distal" joint="finger_middle_joint_3" ctrlrange="-1.2217 -0.0523"/>
  </actuator>

  <keyframe>
    <key name="open" qpos="0 0.0495 0 -0.0523 0 0.0495 0 -0.0523 0.0495 0 -0.0523"
      ctrl="0 0.0495 0 -0.0523 0 0.0495 0 -0.0523 0.0495 0 -0.0523"/>
    <key name="closed" qpos="0 1.15 1.45 -1.15 0 1.15 1.45 -1.15 1.15 1.45 -1.15"
      ctrl="0 1.15 1.45 -1.15 0 1.15 1.45 -1.15 1.15 1.45 -1.15"/>
  </keyframe>
</mujoco>
