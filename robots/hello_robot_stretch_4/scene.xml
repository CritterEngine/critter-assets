<mujoco model="stretch scene">
  <include file="stretch.xml"/>

  <statistic center="0 0 .75" extent="1.2" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.44 0.80 1.00" rgb2="1 1 1" width="512" height="3072"/>
    <material name="floor" rgba=".1 .1 .1 1" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="floor"/>
  </worldbody>

  <contact>
    <pair geom1="floor" geom2="back_wheel_link" condim="3" friction="0.001 1.0" solref="0.005 1" solimp="0.9 0.95 0.001"/>
    <pair geom1="floor" geom2="left_wheel_link" condim="3" friction="0.001 1.0" solref="0.005 1" solimp="0.9 0.95 0.001"/>
    <pair geom1="floor" geom2="right_wheel_link" condim="3" friction="0.001 1.0" solref="0.005 1" solimp="0.9 0.95 0.001"/>
    <pair geom1="floor" geom2="base_link_collision" condim="3" friction="0.0 0.0"/>
  </contact>
</mujoco>
