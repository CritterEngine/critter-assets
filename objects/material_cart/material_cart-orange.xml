<mujoco model="material_cart_orange">
  <compiler angle="radian" autolimits="true"/>
  <option gravity="0 0 -9.81"/>
  <default>
    <default class="wheel">
      <joint type="hinge" axis="1 0 0" damping="0.05" frictionloss="0.02" armature="0.01"/>
      <geom type="cylinder" size="0.125 0.035" quat="0.707107 0 0.707107 0" density="300" group="3" rgba="0 0 0 0" condim="3" friction="1.2 0.005 0.001" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    </default>
  </default>
  <asset>
    <texture name="texture_0" type="2d" file="assets/orange/textures/texture_0.png"/>
    <material name="material_0_lambert1" rgba="1 1 1 1" metallic="1" roughness="1" texture="texture_0"/>
    <mesh name="visual_0" file="assets/orange/meshes/visual_0.obj" inertia="shell"/>
  </asset>
  <worldbody>
    <body name="material_cart_orange">
      <joint name="material_cart_orange_free" type="free" damping="0.05"/>
      <geom name="visual_0" type="mesh" mesh="visual_0" material="material_0_lambert1" group="0" contype="0" conaffinity="0" density="0"/>
      <!-- Upright frame stays clear of the floor. The toe plate parks the truck until it is tipped onto the wheels. -->
      <geom name="frame" type="box" pos="0 0.04 0.76" size="0.22 0.16 0.52" group="3" rgba="0 0 0 0" density="80"/>
      <geom name="toe" type="box" pos="0 -0.235 0.008" size="0.16 0.03 0.008" group="3" rgba="0 0 0 0" density="200" friction="0.6 0.005 0.001"/>
      <body name="wheel_l" pos="-0.238 0.05 0.125">
        <joint name="wheel_l" class="wheel"/>
        <geom name="wheel_l" class="wheel"/>
      </body>
      <body name="wheel_r" pos="0.238 0.05 0.125">
        <joint name="wheel_r" class="wheel"/>
        <geom name="wheel_r" class="wheel"/>
      </body>
    </body>
  </worldbody>
  <contact>
    <exclude body1="material_cart_orange" body2="wheel_l"/>
    <exclude body1="material_cart_orange" body2="wheel_r"/>
  </contact>
</mujoco>
